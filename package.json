{
  "name": "en-marge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Votre bibliothèque d’envies de lecture, en JavaScript et Bun.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --watch src/server.js",
    "start": "bun src/server.js",
    "test": "bun test ./tests/unit",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun test ./tests/unit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
