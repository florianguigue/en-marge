# Port exposed by Docker Compose; set PORT directly for a local Bun server.
PORT=4173

# Local Bun server database path (Compose uses its persistent volume).
DATABASE_PATH=./data/en-marge.sqlite

# Canonical HTTPS origin when deployed behind a reverse proxy.
# PUBLIC_URL=https://en-marge.home.florianguigue.fr

# Server-side metadata credentials. Never exposed to the browser.
# Google Books can be tried without a key; quotas may require one.
GOOGLE_BOOKS_API_KEY=
# Obtain a personal token from https://hardcover.app/account/api
# Hardcover is disabled until this token is set.
HARDCOVER_API_TOKEN=
# Comma-separated IDs: hardcover,google-books
METADATA_DISABLED_PROVIDERS=
